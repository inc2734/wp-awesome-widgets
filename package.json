{
	"engines": {
		"node": ">=24.22.1",
		"npm": ">=11.18.0"
	},
	"volta": {
		"node": "24.22.1"
	},
	"author": "inc2734",
	"license": "GPL-2.0+",
	"devDependencies": {
		"@wordpress/browserslist-config": "^7.0.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/icons": "^15.5.0",
		"@wordpress/scripts": "^37.0.0",
		"autoprefixer": "^10.5.4",
		"cpy-cli": "^7.0.0",
		"cssnano": "^8.0.5",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.26",
		"postcss-cli": "^11.0.1",
		"prettier": "npm:wp-prettier@3.9.6",
		"rimraf": "^6.1.3",
		"sass-basis": "^20.0.1",
		"slick-carousel": "^1.8.1",
		"sass": "^1.102.0"
	},
	"scripts": {
		"wp-env": "wp-env",
		"start": "wp-env start",
		"stop": "wp-env stop",
		"destroy": "wp-env destroy && wp-env destroy --config=.wp-env.tests.json",
		"cli": "wp-env run cli",
		"wp": "wp-env run cli --env-cwd=\"wp-content/plugins/wp-awesome-widgets\" wp",
		"composer": "wp-env run cli --env-cwd=\"wp-content/plugins/wp-awesome-widgets\" composer",
		"test:php:start": "wp-env start --config=.wp-env.tests.json",
		"test-composer": "wp-env run --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/wp-awesome-widgets\" cli composer",
		"pretest:php:lint": "npm run test:php:start && npm run test-composer -- install --no-interaction",
		"test:php:lint": "wp-env run --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/wp-awesome-widgets\" wordpress vendor/bin/phpcs --standard=.phpcs.xml.dist",
		"posttest:php:lint": "wp-env stop --config=.wp-env.tests.json",
		"test:lint:php": "npm run test:php:lint",
		"test:lint:js": "wp-scripts lint-js src/src/blocks",
		"test:lint": "run-s test:lint:php test:lint:js",
		"pretest:php:unit": "npm run test:php:start && npm run test-composer -- install --no-interaction",
		"test:php:unit": "wp-env run --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/wp-awesome-widgets\" wordpress vendor/bin/phpunit -c .phpunit.xml.dist --verbose",
		"posttest:php:unit": "wp-env stop --config=.wp-env.tests.json",
		"test:unit:php": "npm run test:php:unit",
		"test:unit": "run-s test:unit:php",
		"test": "run-s test:lint test:unit",
		"clean:css": "rimraf src/assets/css",
		"clean:js": "rimraf src/assets/js",
		"clean:packages": "rimraf src/assets/packages",
		"clean:translation": "rimraf src/.translation && mkdir -p src/.translation",
		"css:front": "sass --no-source-map src/src/css/app.scss src/assets/css/app.css && postcss -r src/assets/css/app.css -c=postcss.config.js",
		"css:admin": "sass --no-source-map src/src/css/admin.scss src/assets/css/admin.css && postcss -r src/assets/css/admin.css -c=postcss.config.js",
		"css:editor": "sass --no-source-map src/src/css/editor.scss src/assets/css/editor.css && postcss -r src/assets/css/editor.css -c=postcss.config.js",
		"css": "npm run clean:css && npm-run-all -p css:*",
		"js:widget": "wp-scripts build src/src/js/widget/pickup-slider src/src/js/widget/carousel-any-posts src/src/js/widget/slider --output-path=src/assets/js/widget",
		"js:admin": "wp-scripts build src/src/js/admin/admin src/src/js/admin/customize-preview src/src/js/admin/elementor-preview --output-path=src/assets/js/admin",
		"js": "npm run clean:js && npm-run-all -p js:*",
		"blocks:format": "wp-scripts format src/src/blocks",
		"blocks:build": "rimraf src/assets/blocks && wp-scripts build --output-path=src/assets/blocks --source-path=src/src/blocks --experimental-modules",
		"blocks:php": "cpy \"src/src/blocks/**/*.php\" \"src/assets/blocks\"",
		"blocks": "run-s blocks:format blocks:build blocks:php",
		"packages:slick-carousel": "cpy 'node_modules/slick-carousel/slick/**' 'src/assets/packages/slick-carousel/slick'",
		"packages": "rimraf src/assets/packages && npm-run-all -p packages:*",
		"make-pot": "npm run wp i18n -- make-pot ./src/ ./src/languages/inc2734-wp-awesome-widgets-ja.pot --exclude=src/blocks",
		"make-json": "rimraf src/languages/*.json && npm run wp i18n -- make-json ./src/languages/inc2734-wp-awesome-widgets-ja.po --no-purge",
		"build": "npm-run-all -p css js packages blocks"
	}
}
